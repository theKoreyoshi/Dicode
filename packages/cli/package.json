{
  "name": "@dicode/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dicode": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dicode/shared": "0.1.0",
    "@dicode/core": "0.1.0",
    "@dicode/codex-adapter": "0.1.0",
    "@dicode/tui": "0.1.0"
  }
}
