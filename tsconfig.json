{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@dicode/shared": ["packages/shared/src/index.ts"],
      "@dicode/codex-adapter": ["packages/codex-adapter/src/index.ts"],
      "@dicode/core": ["packages/core/src/index.ts"],
      "@dicode/tui": ["packages/tui/src/index.ts"],
      "@dicode/cli": ["packages/cli/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "tests/**/*.ts"
  ]
}
